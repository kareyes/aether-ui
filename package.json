{
	"name": "aether-ui",
	"version": "0.0.19",
	"description": "A Svelte 5 UI component library built with Tailwind CSS",
	"type": "module",
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"ui",
		"tailwindcss",
		"component-library"
	],
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build && bunx --bun svelte-package",
		"package": "bunx --bun svelte-package",
		"watch-package": "bunx --bun svelte-kit sync && bunx --bun svelte-package --watch",
		"preview": "bunx --bun vite preview",
		"prepare": "bunx --bun svelte-kit sync || echo ''",
		"check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"storybook": "bunx --bun storybook dev -p 6006"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.stories.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.js"
		},
		"./constants": {
			"types": "./dist/constants.d.ts",
			"default": "./dist/constants.js"
		},
		"./icons": {
			"types": "./dist/icons.d.ts",
			"svelte": "./dist/icons.js",
			"default": "./dist/icons.js"
		},
		"./forms": {
			"types": "./dist/forms/index.d.ts",
			"svelte": "./dist/forms/index.js",
			"default": "./dist/forms/index.js"
		},
		"./styles": "./dist/styles/theme.css",
		"./styles/theme.css": "./dist/styles/theme.css"
	},
	"peerDependencies": {
		"@lucide/svelte": "^1.24.0",
		"effect": "^3.0.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"effect": {
			"optional": true
		}
	},
	"dependencies": {
		"@internationalized/date": "^3.10.0",
		"@tanstack/table-core": "^8.21.3",
		"bits-ui": "^2.15.4",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@types/bun": "latest",
		"@chromatic-com/storybook": "^4.1.1",
		"@storybook/addon-a11y": "^9.1.10",
		"@storybook/addon-docs": "^9.1.10",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/sveltekit": "^9.1.10",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22",
		"effect": "^3.19.15",
		"formsnap": "^2.0.1",
		"storybook": "^9.1.10",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"sveltekit-superforms": "^2.28.1",
		"tailwindcss": "^4.1.13",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
	}
}
