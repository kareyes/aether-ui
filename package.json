{
  "name": "@kareyes/aether-ui",
  "version": "0.0.19",
  "description": "A Svelte 5 UI component library built with Tailwind CSS",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kareyes/aether-ui.git"
  },
  "homepage": "https://github.com/kareyes/aether-ui",
  "bugs": {
    "url": "https://github.com/kareyes/aether-ui/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "ui",
    "tailwindcss",
    "component-library"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:package": "svelte-kit sync && svelte-package && node scripts/clean-dist.js",
    "watch:package": "svelte-kit sync && svelte-package --watch",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepublishOnly": "bun run build:package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "bun test src/",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit:watch": "bun test src/ --watch",
    "test:storybook": "STORYBOOK_TEST=1 vitest --project=storybook --run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "svelte": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "svelte": "./dist/forms/index.js",
      "default": "./dist/forms/index.js"
    },
    "./styles": "./dist/styles/theme.css",
    "./styles/theme.css": "./dist/styles/theme.css"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.24.0",
    "effect": "^3.0.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/table-core": "^8.21.3",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "@internationalized/date": "^3.10.0",
    "bits-ui": "^2.15.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@chromatic-com/storybook": "4.1.1",
    "@lucide/svelte": "1.32.0",
    "@playwright/test": "1.56.0",
    "@storybook/addon-a11y": "9.1.10",
    "@storybook/addon-docs": "9.1.10",
    "@storybook/addon-svelte-csf": "5.0.10",
    "@storybook/addon-vitest": "9.1.10",
    "@storybook/sveltekit": "9.1.10",
    "@sveltejs/adapter-auto": "6.1.1",
    "@sveltejs/kit": "2.46.5",
    "@sveltejs/package": "2.5.7",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/bun": "1.3.14",
    "@types/node": "22.18.10",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "effect": "3.19.15",
    "formsnap": "2.0.1",
    "playwright": "1.56.0",
    "storybook": "9.1.10",
    "svelte": "5.39.12",
    "svelte-check": "4.3.3",
    "sveltekit-superforms": "2.29.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  },
  "overrides": {
    "esrap": "2.1.0"
  },
  "trustedDependencies": [
    "esbuild",
    "@tailwindcss/oxide"
  ]
}
